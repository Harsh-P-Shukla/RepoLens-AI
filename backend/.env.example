PORT=5000
FRONTEND_URL=https://repo-lens-ai-five.vercel.app
REPOLENS_STORAGE_DIR=
REPOLENS_TEMP_DIR=

# none | ollama | huggingface
AI_PROVIDER=none

# Ollama local model support
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_ENDPOINT=http://localhost:11434/api/embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hugging Face free inference tier
HUGGING_FACE_API_KEY=
HUGGING_FACE_MODEL=HuggingFaceTB/SmolLM3-3B

# auto | ollama | sentence-transformers | local
EMBEDDING_PROVIDER=auto
EMBEDDING_DIMENSIONS=384
SENTENCE_TRANSFORMERS_COMMAND=python
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LanceDB local vector store
VECTOR_DB_PROVIDER=lancedb
VECTOR_DB_DIR=

# Scanner controls
MAX_FILE_SIZE_MB=1
MAX_INDEX_FILES=350
MAX_INDEX_CHUNKS=1400
MAX_CHAT_CONTEXT_CHUNKS=10
MAX_RELATED_CHUNKS=5
CLONE_TIMEOUT_MS=120000
CLEANUP_TEMP=true
